#!/bin/sh
set -e
case "$1" in
  remove|upgrade|deconfigure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop    watcher.service 2>/dev/null || true
      systemctl disable watcher.service 2>/dev/null || true
      systemctl stop    watcher-backup.timer   2>/dev/null || true
      systemctl stop    watcher-backup.service 2>/dev/null || true
      systemctl disable watcher-backup.timer   2>/dev/null || true
    fi
    ;;
esac
exit 0
